# ==============================================================================
# EduKomputer Environment Variables
# ==============================================================================

# Database Connection URL (PostgreSQL)
# For Vercel Postgres / Neon / Supabase:
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_edukomputer_db"

# Session Secret (Optional - for production cookie encryption)
SESSION_SECRET="edukomputer-super-secret-key-change-in-production-32-chars-min"

# Environment Mode
NODE_ENV="production"
